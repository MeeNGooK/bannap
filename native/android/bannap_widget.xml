<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3B2F6F"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="반납" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#D8D1EC" android:textSize="12sp" />
    <TextView android:id="@+id/widget_row_one" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="14sp" />
    <TextView android:id="@+id/widget_row_two" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:ellipsize="end" android:maxLines="1" android:textColor="#EEEAFB" android:textSize="14sp" />
    <TextView android:id="@+id/widget_row_three" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:ellipsize="end" android:maxLines="1" android:textColor="#EEEAFB" android:textSize="14sp" />
</LinearLayout>
